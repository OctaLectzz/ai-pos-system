# Public
NEXT_PUBLIC_APP_NAME="NexPOS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (Supabase)
NEXT_PUBLIC_SUPABASE_URL="http://your-supabase-project-url"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-project-api-key"

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://[user]:[password]@[host]:[port]/[db]?schema=public"
# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://[user]:[password]@[host]:[port]/[db]?schema=public"

# Auth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AI
GEMINI_API_KEY="your-gemini-api-key"

# WhatsApp integration
WA_SERVICE_URL="http://your-wa-bot-service-url"